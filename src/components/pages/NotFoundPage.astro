---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEOHead from '../SEOHead.astro';
import { makeT, pageLang, type Lang } from '../../i18n/site';

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang ?? pageLang(Astro.url.pathname);
const T = makeT('src/pages/404.astro', lang);
---
<BaseLayout>
  <SEOHead slot="head" title={T('seoTitle')} description={T('seoDesc')} noindex />
  <div class="mx-auto max-w-lg px-4 py-24 text-center">
    <p class="text-6xl font-bold text-gray-400 dark:text-gray-600">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-gray-900 dark:text-gray-100">{T('title')}</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-400">{T('body')}</p>
    <a
      href={lang === 'tr' ? '/tr/' : '/'}
      class="mt-8 inline-block rounded-lg bg-brand px-6 py-3 font-medium text-white hover:bg-brand-dark"
    >
      {T('home')}
    </a>
  </div>
</BaseLayout>
