---
/**
 * FAQ sayfasi — hem insan hem cevap motorlari icin.
 *
 * NEDEN: ChatGPT/Perplexity/Google AI Overviews gibi cevap motorlari
 * FAQPage semasini yogun kullanir. Buradaki sorular insanlarin bu tur bir
 * uygulamayi ARARKEN sordugu gercek sorular; cevaplar urunde dogrulanmis.
 *
 * KURAL: uygulamanin yapamadigi seyler de acikca yaziliyor. Eksik gizlemek
 * kisa vadede iyi gorunur ama yanlis oneriye ve kotu yoruma yol acar.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEOHead from '../SEOHead.astro';
import AppSchema from '../AppSchema.astro';
import StoreBadgeRow from '../StoreBadgeRow.astro';
import { makeT, pageLang, type Lang } from '../../i18n/site';

interface Props {
  lang?: Lang;
}
const lang = Astro.props.lang ?? pageLang(Astro.url.pathname);
const T = makeT('src/pages/faq.astro', lang);

const faqs: { q: string; a: string }[] = Array.from({ length: 12 }, (_, i) => ({
  q: T(`q${i + 1}`),
  a: T(`a${i + 1}`),
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout>
  <Fragment slot="head">
    <SEOHead title={T('seo.title')} description={T('seo.description')} />
    <AppSchema />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="brand-hero-title text-3xl md:text-4xl">{T('h1')}</h1>
    <p class="mt-4 text-lg leading-relaxed text-gray-600">{T('intro')}</p>

    <div class="mt-10 divide-y divide-gray-100">
      {faqs.map((f) => (
        <div class="py-6">
          <h2 class="font-display text-xl font-semibold text-gray-900">{f.q}</h2>
          <p class="mt-3 leading-relaxed text-gray-600">{f.a}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 rounded-2xl border border-gray-100 bg-gray-50 p-6">
      <h2 class="font-display text-xl font-semibold text-gray-900">{T('try.h2')}</h2>
      <p class="mt-2 text-gray-600">{T('try.p')}</p>
      <div class="mt-5"><StoreBadgeRow /></div>
    </div>
  </section>
</BaseLayout>
