---
/**
 * Magaza dugmeleri (3.30). Resmi rozet gorseli degil; logo + metin, iki tonda:
 * `tone="light"` acik zeminde koyu dugme, `tone="green"` yesil zeminde beyaz dugme.
 */
import AppleIcon from './AppleIcon.astro';
import GooglePlayIcon from './GooglePlayIcon.astro';
import { makeT, pageLang } from '../i18n/site';

interface Props {
  class?: string;
  /** Eski cagrilarla uyum icin duruyor; gorunumu etkilemez. */
  emphasis?: 'default' | 'secondary';
  tone?: 'light' | 'green';
}

const { class: className, tone = 'light' } = Astro.props;
const T = makeT('src/components/StoreBadgeRow.astro', pageLang(Astro.url.pathname));

const playStoreUrl =
  import.meta.env.PUBLIC_PLAY_STORE_URL ??
  'https://play.google.com/store/apps/details?id=com.mehmet.unutma';
const appStoreUrl =
  import.meta.env.PUBLIC_APP_STORE_URL ??
  'https://apps.apple.com/app/id6758889495';
---

<div class:list={['u-stores', tone === 'green' && 'u-stores--green', className]}>
  <a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="u-store">
    <AppleIcon class="u-store__ic" />
    <span><small>{T('appStore.small')}</small>{T('appStore.name')}</span>
  </a>
  <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="u-store">
    <GooglePlayIcon class="u-store__ic" />
    <span><small>{T('play.small')}</small>{T('play.name')}</span>
  </a>
</div>

<style>
  .u-stores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .u-store {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 54px;
    padding: 0 1.25rem 0 1rem;
    border-radius: 14px;
    background: var(--u-ink);
    color: #fff;
    font-weight: 600;
    font-size: 1.02rem;
    letter-spacing: -0.01em;
    line-height: 1.1;
    transition: transform 0.2s ease, background-color 0.2s ease;
    text-decoration: none;
  }
  .u-store:hover {
    background: #1b3d2e;
  }
  .u-store small {
    display: block;
    font-size: 0.66rem;
    font-weight: 500;
    opacity: 0.75;
    letter-spacing: 0;
  }
  .u-store :global(.u-store__ic) {
    width: 22px;
    height: 22px;
    flex: none;
  }
  .u-stores--green .u-store {
    background: #fff;
    color: var(--u-ink);
    box-shadow: 0 10px 30px -12px rgba(5, 60, 40, 0.45);
  }
  .u-stores--green .u-store:hover {
    background: #f1faf4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .u-store:hover {
      transform: translateY(-1px);
    }
  }
</style>
