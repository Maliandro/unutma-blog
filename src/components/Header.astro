---
/**
 * Ust bar (3.30 yeniden tasarim). Ana sayfada `tone="green"`: yesil sahnenin
 * ustunde saydam ve beyaz yazili baslar, sahne gecince beyaz zemine doner.
 * Diger sayfalarda hep beyaz. Eski "tema" dugmesi hicbir sey yapmiyordu, kaldirildi.
 */
import { withBase } from '../utils/site';
import { makeT, pageLang } from '../i18n/site';
import LangSwitch from './LangSwitch.astro';

interface Props {
  tone?: 'green';
}
const { tone } = Astro.props;
const pathname = Astro.url.pathname;
const lang = pageLang(pathname);
const T = makeT('src/components/Header.astro', lang);
const pre = lang === 'tr' ? '/tr' : '';

const nav = [
  { href: `${pre}/#how`, label: T('nav.how'), key: 'how' },
  { href: `${pre}/#private`, label: T('nav.private'), key: 'private' },
  { href: `${pre}/blog/`, label: T('nav.blog'), key: 'blog' },
  { href: lang === 'tr' ? '/tr/sss/' : '/faq/', label: T('nav.faq'), key: 'faq' },
];

const isActive = (key: string) =>
  (key === 'blog' && /^\/(tr\/)?blog/.test(pathname)) || (key === 'faq' && /^\/(faq|tr\/sss)/.test(pathname));
---

<header class:list={['u-head', tone === 'green' && 'is-green']} data-u-head>
  <div class="u-head__in">
    <a href={withBase(`${pre}/`)} class="u-head__brand" aria-label={T('brandAria')}>
      <img src={withBase('/unutma-icon.png')} width="36" height="36" alt="" decoding="async" />
      <span>Unutma</span>
    </a>

    <nav class="u-head__nav" aria-label={T('navAria')}>
      {nav.map(({ href, label, key }) => (
        <a href={href} aria-current={isActive(key) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>

    <div class="u-head__end">
      <LangSwitch class="u-head__lang" />
      <a href={`${pre}/#get`} class="u-head__cta">{T('cta')}</a>
      <button
        type="button"
        id="mobile-menu-btn"
        class="u-head__menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label={T('menuOpenAria')}
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="2" d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="mobile-drawer" class="u-drawer" hidden role="dialog" aria-modal="true" aria-label={T('drawerAria')}>
  <button type="button" id="mobile-drawer-backdrop" class="u-drawer__back" tabindex="-1" aria-label={T('menuCloseAria')}></button>
  <div class="u-drawer__panel">
    <div class="u-drawer__top">
      <span class="u-drawer__title">{T('drawerTitle')}</span>
      <button type="button" id="mobile-menu-close" class="u-head__menu" aria-label={T('menuCloseAria')}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="u-drawer__nav" aria-label={T('navAria')}>
      <a href={`${pre}/`} data-mobile-nav-link>{T('drawer.home')}</a>
      {nav.map(({ href, label }) => <a href={href} data-mobile-nav-link>{label}</a>)}
      <a href={lang === 'tr' ? '/tr/hakkinda/' : '/about/'} data-mobile-nav-link>{T('drawer.about')}</a>
      <a href={lang === 'tr' ? '/support/tr/' : '/support/'} data-mobile-nav-link>{T('drawer.support')}</a>
    </nav>
    <LangSwitch class="u-drawer__lang" />
    <a href={`${pre}/#get`} class="u-drawer__cta" data-mobile-nav-link>{T('cta')}</a>
  </div>
</div>

<style>
  .u-head {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--u-line);
    transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
    color: var(--u-ink);
  }
  .u-head.is-green {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    border-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    color: #fff;
  }
  .u-head.is-green.is-solid {
    background: rgba(255, 255, 255, 0.94);
    border-color: var(--u-line);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    color: var(--u-ink);
  }
  .u-head__in {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.7rem 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .u-head__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.12rem;
    letter-spacing: -0.03em;
    color: inherit;
    border-radius: 12px;
  }
  .u-head__brand img {
    width: 36px;
    height: 36px;
    border-radius: 22%;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.4) inset, 0 4px 14px rgba(5, 85, 61, 0.22);
  }
  .u-head__nav {
    display: none;
    margin-left: auto;
    gap: 1.75rem;
    font-size: 0.86rem;
    font-weight: 500;
  }
  .u-head__nav a {
    color: inherit;
    opacity: 0.82;
    padding: 0.4rem 0;
    transition: opacity 0.2s;
  }
  .u-head__nav a:hover,
  .u-head__nav a[aria-current='page'] {
    opacity: 1;
  }
  .u-head__nav a[aria-current='page'] {
    box-shadow: 0 2px 0 currentColor;
  }
  .u-head__end {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .u-head__cta {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    background: var(--u-green);
    color: #fff;
    transition: background-color 0.2s;
  }
  .u-head__cta:hover {
    background: var(--u-green-deep);
  }
  .is-green:not(.is-solid) .u-head__cta {
    background: #fff;
    color: var(--u-green-deep);
  }
  .u-head__menu {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: inherit;
  }
  .u-head__menu:hover {
    background: rgba(127, 127, 127, 0.12);
  }
  @media (min-width: 860px) {
    .u-head__nav {
      display: flex;
    }
    .u-head__end {
      margin-left: 1.25rem;
    }
    .u-head__menu {
      display: none;
    }
  }
  @media (max-width: 520px) {
    .u-head__cta {
      display: none;
    }
  }
  .u-head__end :global(.u-lang) {
    margin-right: 0.15rem;
  }
  .u-drawer__panel :global(.u-drawer__lang) {
    align-self: flex-start;
    margin: 0 0 1rem;
  }

  .u-drawer {
    position: fixed;
    inset: 0;
    z-index: 60;
  }
  .u-drawer[hidden] {
    display: none;
  }
  .u-drawer__back {
    position: absolute;
    inset: 0;
    background: rgba(15, 42, 31, 0.45);
  }
  .u-drawer__panel {
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    width: min(21rem, calc(100vw - 2rem));
    background: #fff;
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1rem 1.5rem;
    box-shadow: -20px 0 60px rgba(15, 42, 31, 0.18);
    color: var(--u-ink);
  }
  .u-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--u-line);
  }
  .u-drawer__title {
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .u-drawer__nav {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0;
    flex: 1;
  }
  .u-drawer__nav a {
    padding: 0.85rem 0.25rem;
    font-size: 1.05rem;
    font-weight: 600;
    border-bottom: 1px solid var(--u-mint);
  }
  .u-drawer__cta {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 52px;
    border-radius: 999px;
    background: var(--u-green);
    color: #fff;
    font-weight: 600;
  }
</style>

<script is:inline>
  (function () {
    var drawer = document.getElementById('mobile-drawer');
    var openBtn = document.getElementById('mobile-menu-btn');
    var closeBtn = document.getElementById('mobile-menu-close');
    var backdrop = document.getElementById('mobile-drawer-backdrop');
    if (!drawer || !openBtn) return;
    function openMenu() {
      drawer.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      var first = drawer.querySelector('[data-mobile-nav-link]');
      if (first) first.focus();
    }
    function closeMenu() {
      drawer.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      openBtn.focus();
    }
    openBtn.addEventListener('click', openMenu);
    closeBtn && closeBtn.addEventListener('click', closeMenu);
    backdrop && backdrop.addEventListener('click', closeMenu);
    drawer.querySelectorAll('[data-mobile-nav-link]').forEach(function (a) {
      a.addEventListener('click', function () {
        drawer.hidden = true;
        openBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !drawer.hidden) closeMenu();
    });

    // Yesil sahne gecince ust bar beyaza doner (sahne DOM'da bu betikten sonra gelir).
    document.addEventListener('DOMContentLoaded', function () {
      var head = document.querySelector('[data-u-head]');
      var hero = document.querySelector('[data-hero]');
      if (!head || !hero || !head.classList.contains('is-green')) return;
      if (!('IntersectionObserver' in window)) {
        head.classList.add('is-solid');
        return;
      }
      new IntersectionObserver(
        function (entries) {
          head.classList.toggle('is-solid', !entries[0].isIntersecting);
        },
        { rootMargin: '-64px 0px 0px 0px' }
      ).observe(hero);
    });
  })();
</script>
