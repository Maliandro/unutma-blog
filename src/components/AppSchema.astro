---
/**
 * SoftwareApplication + Organization JSON-LD.
 *
 * NEDEN: Site canonical/OG/BlogPosting semasina sahipti ama hicbir yerde
 * uygulamanin KENDISI makine-okunur degildi. Arama motorlari ve cevap
 * motorlari (ChatGPT, Perplexity, Google AI Overviews) bir uygulamayi
 * onerebilmek icin once ne oldugunu, hangi platformda oldugunu, ne kadar
 * tuttugunu yapilandirilmis bicimde bilmek zorunda.
 *
 * Buradaki her iddia uründe DOGRULANMIS olmalidir. aggregateRating bilerek
 * YOK: gercek oy sayisi cok dusuk (n=7) ve sisirilmis puan gostermek hem
 * Google yapisal veri politikasina hem kullanicinin sahte-sosyal-kanit
 * kuralina aykiri olur.
 */
import { makeT, pageLang } from '../i18n/site';
const lang = pageLang(Astro.url.pathname);
const T = makeT('src/components/AppSchema.astro', lang);
const APP_STORE = 'https://apps.apple.com/app/id6758889495';
const PLAY_STORE = 'https://play.google.com/store/apps/details?id=com.mehmet.unutma';
// Domain TEK kaynaktan (astro.config.mjs -> Astro.site). Elle yazmak, 2026-08'de
// canonical'in baskasinin domain'ini gostermesine yol acan hatanin ta kendisiydi.
const SITE = (Astro.site?.href ?? 'https://unutma.meyadestudio.com/').replace(/\/$/, '');

const featureList = Array.from({ length: 12 }, (_, i) => T(`featureList[${i}]`));

const organization = {
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: 'Unutma',
  url: SITE,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE}/unutma-icon.png`,
  },
  // 2026-10-03: resmî hesaplar + mağaza sayfaları. Arama ve cevap motorları markayı
  // bu bağlantılarla tek bir varlık olarak tanır (Knowledge Graph).
  sameAs: [
    'https://www.instagram.com/life_admin_assistant/',
    'https://www.youtube.com/channel/UCrQXJXpD_ixGkfGQgouqVww',
    'https://www.facebook.com/1169165316276395',
    'https://apps.apple.com/app/id6758889495',
    'https://play.google.com/store/apps/details?id=com.mehmet.unutma',
  ],
};

const app = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE}/#app`,
      name: T('name'),
      alternateName: ['Unutma', 'Unutma Private Life Organizer'],
      applicationCategory: 'ProductivityApplication',
      applicationSubCategory: 'Personal organizer',
      operatingSystem: 'iOS, Android',
      url: SITE,
      downloadUrl: [APP_STORE, PLAY_STORE],
      installUrl: [APP_STORE, PLAY_STORE],
      publisher: { '@id': `${SITE}/#organization` },
      inLanguage: ['en', 'tr', 'de', 'es', 'fr', 'it'],
      featureList,
      description: T('description'),
      // 2026-11-20: offers yalnizca "ucretsiz indirme" (price 0) + magaza baglantisi.
      // Abonelik/omur boyu fiyati BILEREK yazilmaz: ulkeye gore degisir, magazadan okunur.
      // aggregateRating hala YOK (gercek oy sayisi cok dusuk).
      offers: [
        { '@type': 'Offer', price: '0', priceCurrency: 'USD', url: APP_STORE, availability: 'https://schema.org/InStock', category: T('offer.category') },
        { '@type': 'Offer', price: '0', priceCurrency: 'USD', url: PLAY_STORE, availability: 'https://schema.org/InStock', category: T('offer.category') },
      ],
      image: `${SITE}/blog/covers/${lang === 'tr' ? 'v3-tr' : 'v3'}/site-default.jpg`,
      // Dogrulanabilir, urunde gercekten var olan ayirt edici ozellikler.
      additionalProperty: Array.from({ length: 8 }, (_, i) => ({
        '@type': 'PropertyValue',
        name: T(`additionalProperty[${i * 2}]`),
        value: T(`additionalProperty[${i * 2 + 1}]`),
      })),
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(app)} />
