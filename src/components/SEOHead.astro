---
import { OG_LOCALES, hreflangPair, pageLang, rssPath } from '../i18n/site';
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  publishedDate?: Date | string;
  /** Guncelleme tarihi — tazelik sinyali. */
  modifiedDate?: Date | string;
  /** Yazi etiketleri; schema keywords + article:tag olarak kullanilir. */
  keywords?: string[];
  /** true: sayfa dizine alinmasin (404 gibi). Canonical da basilmaz. */
  noindex?: boolean;
  /** Dil alternatifleri (hreflang). Ornek: [{ lang: 'tr', href: '/privacy/tr/' }]. */
  alternates?: { lang: string; href: string }[];
  /** og:locale, ornek tr_TR. Varsayilan en_US. */
  locale?: string;
  /** Paylasim gorselinin aciklamasi (og:image:alt / twitter:image:alt). */
  imageAlt?: string;
}

const {
  title,
  description,
  // Varsayilan paylasim gorseli 1200x630 (scripts/kapak-uret.mjs, 'site-default').
  image = '/blog/covers/v3/site-default.jpg',
  article = false,
  publishedDate,
  modifiedDate,
  keywords = [],
  noindex = false,
  alternates = [],
  locale: localeProp,
  imageAlt,
} = Astro.props;
const uiLang = pageLang(Astro.url.pathname);
const locale = localeProp ?? OG_LOCALES[uiLang];
// Verilmediyse hreflang cifti adres yolundan hesaplanir (EN <-> TR).
const pair = alternates.length === 0 ? hreflangPair(Astro.url.pathname) : null;
// 1200x630 kapaklar (covers/v3) icin boyut etiketleri basilir; svg/ikon icin basilmaz.
const isWide = /\/covers\/v3\//.test(image);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteRoot = (Astro.site?.href ?? 'https://unutma.meyadestudio.com/').replace(/\/$/, '');
const fullTitle = `${title} | Unutma Blog`;
const baseRoot = new URL(import.meta.env.BASE_URL, Astro.site);
const ogImage = new URL(image.replace(/^\//, ''), baseRoot).href;
const publishedIso =
  publishedDate instanceof Date
    ? publishedDate.toISOString()
    : publishedDate
      ? new Date(publishedDate).toISOString()
      : undefined;

// Yayinci/yazar bilgisi ayri tutuluyor: arama ve cevap motorlari icerigin
// KIMDEN geldigini bilemedigi zaman alintilamaya daha isteksiz oluyor.
const publisher = {
  '@type': 'Organization',
  name: 'Unutma',
  url: siteRoot,
  logo: {
    '@type': 'ImageObject',
    url: `${siteRoot}/unutma-icon.png`,
  },
  // 2026-10-03: resmî hesaplar + mağaza sayfaları. Arama ve cevap motorları markayı
  // bu bağlantılarla tek bir varlık olarak tanır (Knowledge Graph).
  sameAs: [
    'https://www.instagram.com/life_admin_assistant/',
    'https://www.youtube.com/channel/UCrQXJXpD_ixGkfGQgouqVww',
    'https://www.facebook.com/1169165316276395',
    'https://apps.apple.com/app/id6758889495',
    'https://play.google.com/store/apps/details?id=com.mehmet.unutma',
  ],
};

const modifiedIso =
  modifiedDate instanceof Date
    ? modifiedDate.toISOString()
    : modifiedDate
      ? new Date(modifiedDate).toISOString()
      : undefined;

const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      name: fullTitle,
      description,
      url: canonicalURL.toString(),
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
      datePublished: publishedIso,
      // dateModified yoksa Google yayin tarihini tazelik sinyali olarak kullanir.
      dateModified: modifiedIso ?? publishedIso,
      image: ogImage.toString(),
      author: publisher,
      publisher,
      inLanguage: uiLang,
      // Yazinin konusu uygulamanin kendisi: AppSchema'daki SoftwareApplication'a baglanir.
      about: { '@id': `${siteRoot}/#app` },
      ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
      isAccessibleForFree: true,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Unutma',
      alternateName: fullTitle,
      description,
      url: canonicalURL.toString(),
      publisher,
      inLanguage: uiLang,
    };
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonicalURL} />}
{alternates.map((a) => (
  <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site).href} />
))}
{/* EN <-> TR karsiligi olan sayfalar: en + tr + x-default (EN). */}
{!noindex && pair && (
  <>
    <link rel="alternate" hreflang="en" href={new URL(pair.en, Astro.site).href} />
    <link rel="alternate" hreflang="tr" href={new URL(pair.tr, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(pair.en, Astro.site).href} />
  </>
)}
{/* Karsiligi olmayan sayfa (etiket vb.): kendini bildirir. */}
{!noindex && alternates.length === 0 && !pair && (
  <>
    <link rel="alternate" hreflang={uiLang} href={canonicalURL} />
    {uiLang === 'en' && <link rel="alternate" hreflang="x-default" href={canonicalURL} />}
  </>
)}
<link rel="alternate" type="application/rss+xml" title="Unutma Blog" href={new URL(rssPath(uiLang).slice(1), baseRoot)} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{isWide && <meta property="og:image:width" content="1200" />}
{isWide && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt ?? title} />
<meta property="og:site_name" content="Unutma" />
<meta property="og:locale" content={locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt ?? title} />

<!-- Pinterest -->
<meta name="pinterest-rich-pin" content="true" />

{article && publishedIso && (
  <meta property="article:published_time" content={publishedIso} />
)}
{article && modifiedIso && (
  <meta property="article:modified_time" content={modifiedIso} />
)}
{article && keywords.map((k) => <meta property="article:tag" content={k} />)}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
