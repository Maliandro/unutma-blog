---
/**
 * Ana sayfa "Nasil calisir" bolumu — uygulamanin icini gosteren hareketli telefonlar (20 Kas 2026).
 *
 * 1-4: canli HTML ekranlar; metinler ve akis magaza-3.30 ham ekranlarinin birebir kopyasi
 *      (a1-park, a2-ask, a4-ask/a4-move, e-home Hizli Eylemler). Uydurma ozellik YOK.
 * 5-7: GERCEK 3.30 ekran goruntuleri (public/img/app/v330/{en,tr}) uzerine GSAP katmani.
 * Hareket yalniz transform/opacity; ekrana girince oynar, cikinca durur.
 * prefers-reduced-motion: her ekran son karesinde durur (CSS varsayilani = son kare).
 */
import { withBase } from '../../utils/site';
import { makeT, type Lang } from '../../i18n/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const T = makeT('src/pages/index.astro', lang);
const icon = withBase('/unutma-icon.png');
const shot = (n: string) => withBase(`/img/app/v330/${lang}/${n}.webp`);
const money = lang === 'tr'
  ? { total: 3125, r1: '₺1.250', r2: '₺1.875', locale: 'tr-TR', cur: 'TRY' }
  : { total: 312, r1: '$125', r2: '$187', locale: 'en-US', cur: 'USD' };
const totalStr = new Intl.NumberFormat(money.locale, { style: 'currency', currency: money.cur, maximumFractionDigits: 0 }).format(money.total);

const records = [
  { img: 'e-todo', label: T('rail.todo') },
  { img: 'e-shopping', label: T('rail.shopping') },
  { img: 'e-calendar', label: T('rail.calendar') },
  { img: 'e-journal', label: T('rail.journal') },
];
---

<section class="how" id="how">
  <div class="wrap">
    <h2 class="h2">{T('how.h2')}</h2>
    <p class="lead">{T('how.lead')}</p>
  </div>

  <div class="wrap how__list">
    <!-- 1. Bir kez soyle, sonra sor -->
    <article class="feat">
      <div class="feat__txt">
        <h3>{T('feat1.title')}</h3>
        <p>{T('feat1.body')}</p>
      </div>
      <div class="dev" role="img" aria-label={T('d1.aria')} data-demo="later">
        <div class="scr" aria-hidden="true">
          <div class="top"><span class="top__back"></span><img src={icon} alt="" width="40" height="40" loading="lazy" /><div><b>{T('chat.name')}</b><small><i></i>{T('chat.status')}</small></div></div>
          <div class="body"><div class="feed" data-feed>
            <p class="u" data-m>{T('d1.u1')}</p>
            <div class="card" data-m>
              <span class="k"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z" /><path d="M10 12h5M10 16h5" /></svg>{T('d1.k')}<em>{T('d.fix')}</em></span>
              <b>{T('d1.u1')}</b>
              <i class="ok" data-ok></i>
            </div>
            <p class="u" data-m>{T('d1.u2')}</p>
            <div class="b b--ans" data-m>
              <p>{T('d1.a')}</p>
              <span class="src__h">{T('d.src')}</span>
              <span class="src"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z" /></svg><span><b>{T('d1.u1')}</b><small>{T('d1.srcSub')}</small></span></span>
            </div>
            </div>
            <span class="dots" data-dots><i></i><i></i><i></i></span>
          </div>
          <div class="in"><span class="in__mic"><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></svg></span><span class="in__t"><span data-in></span><span class="in__ph" data-ph>{T('d.input')}</span></span><span class="in__send" data-send></span></div>
        </div>
      </div>
    </article>

    <!-- 2. Kendi hayatini sor -->
    <article class="feat feat--flip">
      <div class="feat__txt">
        <h3>{T('feat2.title')}</h3>
        <p>{T('feat2.body')}</p>
      </div>
      <div class="dev" role="img" aria-label={T('d2.aria')} data-demo="life" data-total={money.total} data-locale={money.locale} data-cur={money.cur}>
        <div class="scr" aria-hidden="true">
          <div class="top"><span class="top__back"></span><img src={icon} alt="" width="40" height="40" loading="lazy" /><div><b>{T('chat.name')}</b><small><i></i>{T('chat.status')}</small></div></div>
          <div class="body"><div class="feed" data-feed>
            <p class="u" data-m>{T('d2.u')}</p>
            <div class="card card--plain" data-m>
              <span class="k"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2.5" /><path d="M16 12.5h2M3 10h18" /></svg>{T('d2.k')}<strong data-total-out>{totalStr}</strong></span>
              <span class="row" data-row><span>{T('d2.r1')}</span><small>{T('d2.r1d')}</small><b>{money.r1}</b></span>
              <span class="row" data-row><span>{T('d2.r2')}</span><small>{T('d2.r2d')}</small><b>{money.r2}</b></span>
              <span class="src__h">{T('d.src')}</span>
              <span class="src" data-row><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2.5" /><path d="M3 10h18" /></svg><span><b>{T('d2.k')}</b><small>{T('d2.srcSub')}</small></span></span>
            </div>
            <p class="u" data-m>{T('d2.u2')}</p>
            <div class="card card--plain" data-m>
              <span class="k"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M9 3v4M15 3v4" /></svg>{T('d2.k2')}</span>
              <span class="row row--t" data-row2><em>{T('d2.t1')}</em><span>{T('d2.e1')}</span></span>
              <span class="row row--t" data-row2><em>{T('d2.t2')}</em><span>{T('d2.e2')}</span></span>
              <span class="row row--t" data-row2><em>{T('d2.t3')}</em><span>{T('d2.e3')}</span></span>
              <span class="row row--t" data-row2><em>{T('d2.t4')}</em><span>{T('d2.e4')}</span></span>
            </div>
            </div>
            <span class="dots" data-dots><i></i><i></i><i></i></span>
          </div>
          <div class="in"><span class="in__mic"><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></svg></span><span class="in__t"><span data-in></span><span class="in__ph" data-ph>{T('d.input')}</span></span><span class="in__send" data-send></span></div>
        </div>
      </div>
    </article>

    <!-- 3. Soyleyerek degistir -->
    <article class="feat">
      <div class="feat__txt">
        <h3>{T('feat3.title')}</h3>
        <p>{T('feat3.body')}</p>
      </div>
      <div class="dev" role="img" aria-label={T('d3.aria')} data-demo="change">
        <div class="scr" aria-hidden="true">
          <div class="top"><span class="top__back"></span><img src={icon} alt="" width="40" height="40" loading="lazy" /><div><b>{T('chat.name')}</b><small><i></i>{T('chat.status')}</small></div></div>
          <div class="body"><div class="feed" data-feed>
            <p class="u" data-m>{T('d3.u1')}</p>
            <div class="b b--ok" data-m>
              <i class="tick"></i>
              <span>{T('d3.r1a')} → <span class="swap"><s data-old>{T('d3.r1old')}</s><span data-new>{T('d3.r1b')}</span></span></span>
            </div>
            <p class="u" data-m>{T('d3.u2')}</p>
            <div class="swap swap--block" data-m>
              <div class="b" data-q>
                <span>{T('d3.q')}</span>
                <span class="btns"><span class="btn btn--yes" data-yes>{T('d3.yes')}</span><span class="btn">{T('d.fix')}</span></span>
              </div>
              <div class="b b--ok b--undo" data-done>
                <em>{T('d.undo')}</em>
                <i class="tick"></i>
                <span>{T('d3.r2')}</span>
              </div>
            </div>
            </div>
            <span class="dots" data-dots><i></i><i></i><i></i></span>
          </div>
          <div class="in"><span class="in__mic"><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /></svg></span><span class="in__t"><span data-in></span><span class="in__ph" data-ph>{T('d.input')}</span></span><span class="in__send" data-send></span></div>
          <span class="tap" data-tap></span>
        </div>
      </div>
    </article>

    <!-- 4. Hizli Eylemler -->
    <article class="feat feat--flip">
      <div class="feat__txt">
        <h3>{T('feat4.title')}</h3>
        <p>{T('feat4.body')}</p>
      </div>
      <div class="dev" role="img" aria-label={T('d4.aria')} data-demo="quick">
        <div class="scr scr--home" aria-hidden="true">
          <div class="app"><img src={icon} alt="" width="40" height="40" loading="lazy" /><b>Unutma</b>
            <svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="7" /><path d="M12 10v3l2 1.5M5 4 3 6M19 4l2 2" /></svg>
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.8 1.2V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 7 19.4a1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 1.2 14H1a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 2.6 7a1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 7 2.6 1.7 1.7 0 0 0 10 1.2V1a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 2.6 1.4 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V7a1.7 1.7 0 0 0 1.5 1H23a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg>
          </div>
          <div class="next"><span class="next__ic"><svg viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z" /><path d="M10 20.5h4" /></svg></span>{T('d4.next')}</div>
          <div class="next next--today"><span class="next__ic"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M9 3v4M15 3v4" /></svg></span>{T('d4.today')}<svg class="next__go" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></div>
          <div class="qa">
            <div class="qa__h"><b><svg viewBox="0 0 24 24"><path d="M13 3 5 14h6l-1 7 8-11h-6z" /></svg>{T('d4.h')}</b><em>{T('d4.edit')}</em></div>
            <small class="qa__sub">{T('d4.sub')}</small>
            <span class="qi"><span class="qi__ic"><svg viewBox="0 0 24 24"><rect x="6" y="11" width="12" height="9" rx="2" /><path d="M9 11V8a3 3 0 0 1 6 0v3" /></svg></span>{T('d4.i1')}<time>{T('d4.i1t')}</time></span>
            <span class="qi"><span class="qi__ic"><svg viewBox="0 0 24 24"><path d="M12 3c3 4 5 6.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.5 1 2.5 2 2.5 0-3 0-5 1-8z" /></svg></span>{T('d4.i2')}<time>{T('d4.i2t')}</time></span>
            <span class="qi" data-qi><span class="qi__ic"><svg viewBox="0 0 24 24"><rect x="4" y="7" width="16" height="13" rx="2" /><path d="M9 7V5h6v2M12 11v5M9.5 13.5h5" /></svg></span>{T('d4.i3')}<time data-qt>{T('d4.i3t')}</time></span>
            <span class="qi"><span class="qi__ic"><svg viewBox="0 0 24 24"><path d="M8 4 4 7l2 3 2-1v11h8V9l2 1 2-3-4-3c-.5 1.5-2 2.5-4 2.5S8.5 5.5 8 4z" /></svg></span>{T('d4.i4')}</span>
            <span class="qi" data-qi><span class="qi__ic"><svg viewBox="0 0 24 24"><path d="M12 3v8M7.5 6.5a7 7 0 1 0 9 0" /></svg></span>{T('d4.i5')}<time data-qt>{T('d4.i5t')}</time></span>
          </div>
          <div class="nav">
            <svg class="on" viewBox="0 0 24 24"><path d="M13 3 5 14h6l-1 7 8-11h-6z" /></svg>
            <svg viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></svg>
            <img src={icon} alt="" width="40" height="40" loading="lazy" />
            <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2.5" /><path d="M16 12.5h2M3 10h18" /></svg>
            <svg viewBox="0 0 24 24"><path d="M3 5c3-1 6-1 9 1 3-2 6-2 9-1v14c-3-1-6-1-9 1-3-2-6-2-9-1z" /><path d="M12 6v14" /></svg>
          </div>
          <span class="tap" data-tap></span>
        </div>
      </div>
    </article>

    <!-- 5. Rutinler (gercek ekran) -->
    <article class="feat">
      <div class="feat__txt">
        <h3>{T('feat5.title')}</h3>
        <p>{T('feat5.body')}</p>
      </div>
      <div class="dev" role="img" aria-label={T('d5.aria')} data-demo="routine">
        <div class="scr scr--shot" aria-hidden="true">
          <img class="shot" src={shot('e-reminders')} alt="" width="600" height="1300" loading="lazy" decoding="async" data-shot />
          <span class="chk" data-chk></span>
          <div class="nt" data-nt>
            <img src={icon} alt="" width="40" height="40" loading="lazy" />
            <span><b>{T('d5.app')}</b><span>{T('d5.n')}</span></span>
            <small>{T('d5.now')}</small>
          </div>
        </div>
      </div>
    </article>

    <!-- 6. Ekonomi (gercek ekran) -->
    <article class="feat feat--flip">
      <div class="feat__txt">
        <h3>{T('feat6.title')}</h3>
        <p>{T('feat6.body')}</p>
      </div>
      <div class="dev" role="img" aria-label={T('d6.aria')} data-demo="budget">
        <div class="scr scr--shot" aria-hidden="true">
          <img class="shot" src={shot('e-economy')} alt="" width="600" height="1300" loading="lazy" decoding="async" data-shot />
          <span class="hit" data-hit></span>
          <span class="drop" data-drop><i></i>{T('d6.chip')}</span>
        </div>
      </div>
    </article>
  </div>

  <!-- 7. Kayitlarim: gercek ekranlar arasinda kaydirma -->
  <div class="wrap recs">
    <div class="recs__txt">
      <h3>{T('rail.h3')}</h3>
      <p>{T('rail.p')}</p>
      <div class="recs__tabs" role="tablist" aria-label={T('rail.tabsAria')}>
        {records.map((r, i) => (
          <button type="button" role="tab" class="recs__tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>{r.label}</button>
        ))}
      </div>
    </div>
    <div class="dev dev--recs" data-recs>
      <div class="scr">
        <div class="recs__track" data-track>
          {records.map((r, i) => (
            <img src={shot(r.img)} alt={T('rail.phoneAria', { label: r.label })} width="600" height="1300" loading="lazy" decoding="async" aria-hidden={i === 0 ? undefined : 'true'} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  window.addEventListener('DOMContentLoaded', function () {
    var gsap = window.gsap, ST = window.ScrollTrigger;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Kayitlarim sekmeleri: hareket azaltilsa da calisir ---- */
    var recs = document.querySelector('[data-recs]');
    var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-tab]'));
    var track = document.querySelector('[data-track]');
    var cur = 0, auto = null;
    function show(i, instant) {
      cur = (i + tabs.length) % tabs.length;
      tabs.forEach(function (t, k) { t.setAttribute('aria-selected', k === cur ? 'true' : 'false'); });
      Array.prototype.forEach.call(track.children, function (im, k) { if (k === cur) im.removeAttribute('aria-hidden'); else im.setAttribute('aria-hidden', 'true'); });
      if (gsap && !instant && !reduce) gsap.to(track, { xPercent: -100 * cur, duration: 0.7, ease: 'power3.inOut', overwrite: true });
      else track.style.transform = 'translateX(' + (-100 * cur) + '%)';
    }
    tabs.forEach(function (t) {
      t.addEventListener('click', function () { show(+t.getAttribute('data-tab')); if (auto) auto.restart(true); });
    });

    if (!gsap || reduce) return;
    if (ST) gsap.registerPlugin(ST);
    document.documentElement.classList.add('js-demos');

    function $(root, s) { return root.querySelector(s); }
    function $$(root, s) { return Array.prototype.slice.call(root.querySelectorAll(s)); }

    // Giris kutusuna yazi yaz, gonder; kutu bosalir.
    function typeIn(tl, root, text, dur) {
      var out = $(root, '[data-in]'), ph = $(root, '[data-ph]'), send = $(root, '[data-send]');
      var st = { n: 0 };
      tl.set(st, { n: 0 })
        .call(function () { ph.style.display = 'none'; })
        .to(st, { n: text.length, duration: dur, ease: 'none', onUpdate: function () { out.textContent = text.slice(0, Math.round(st.n)); } })
        .to(send, { scale: 0.78, duration: 0.12, yoyo: true, repeat: 1 }, '+=0.25')
        .call(function () { out.textContent = ''; ph.style.display = ''; });
      return tl;
    }
    // Sohbet akisi: yeni oge alta gelsin diye akis (transform ile) yukari kayar.
    function shift(el) {
      var f = el.closest('[data-feed]');
      return f.offsetHeight - (el.offsetTop + el.offsetHeight);
    }
    function pop(tl, el, pos) {
      var f = el.closest('[data-feed]');
      if (f) tl.to(f, { y: function () { return shift(el); }, duration: 0.45, ease: 'power2.out' }, pos);
      return tl.fromTo(el, { autoAlpha: 0, y: 14, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.45, ease: 'back.out(1.6)', immediateRender: false }, f ? '<' : pos);
    }
    function thinking(tl, root) {
      var d = $(root, '[data-dots]'), f = $(root, '[data-feed]');
      tl.to(f, { y: function () { return (gsap.getProperty(f, 'y') || 0) - d.offsetHeight - 6; }, duration: 0.3 })
        .to(d, { autoAlpha: 1, duration: 0.2 }, '<0.1').to($$(d, 'i'), { y: -3, duration: 0.25, stagger: 0.12, yoyo: true, repeat: 3, ease: 'sine.inOut' }, '<').to(d, { autoAlpha: 0, duration: 0.15 });
      return tl;
    }
    function reset(tl, root) {
      tl.to($(root, '.body'), { autoAlpha: 0, duration: 0.45, ease: 'power1.in' }, '+=2.6').set($(root, '.body'), { autoAlpha: 1 });
    }
    function tapAt(tl, root, target, pos) {
      var tap = $(root, '[data-tap]'), scr = $(root, '.scr');
      tl.call(function () {
        var a = scr.getBoundingClientRect(), b = target.getBoundingClientRect();
        gsap.set(tap, { x: b.left - a.left + b.width / 2, y: b.top - a.top + b.height / 2 });
      }, null, pos)
        .fromTo(tap, { autoAlpha: 0, scale: 1.6 }, { autoAlpha: 1, scale: 1, duration: 0.3, ease: 'power2.out', immediateRender: false })
        .to(target, { scale: 0.93, duration: 0.1, yoyo: true, repeat: 1 })
        .to(tap, { autoAlpha: 0, scale: 1.8, duration: 0.35 });
      return tl;
    }

    var builders = {
      later: function (root) {
        var m = $$(root, '[data-m]'), ok = $(root, '[data-ok]');
        gsap.set(m, { autoAlpha: 0 }); gsap.set(ok, { scale: 0 });
        var tl = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 0.6, defaults: { ease: 'power2.out' } });
        tl.set(m, { autoAlpha: 0 }).set(ok, { scale: 0 }).set($(root, '[data-feed]'), { y: function () { return shift(m[0]); } });
        typeIn(tl, root, m[0].textContent, 1.3);
        pop(tl, m[0]); pop(tl, m[1], '+=0.35');
        tl.to(ok, { scale: 1, duration: 0.4, ease: 'back.out(2.6)' }, '-=0.1');
        typeIn(tl, root, m[2].textContent, 0.8);
        pop(tl, m[2]); thinking(tl, root); pop(tl, m[3]);
        reset(tl, root);
        return tl;
      },
      life: function (root) {
        var m = $$(root, '[data-m]'), rows = $$(root, '[data-row]'), rows2 = $$(root, '[data-row2]');
        var out = $(root, '[data-total-out]'), total = +root.getAttribute('data-total');
        var fmt = new Intl.NumberFormat(root.getAttribute('data-locale'), { style: 'currency', currency: root.getAttribute('data-cur'), maximumFractionDigits: 0 });
        var st = { v: 0 };
        gsap.set(m, { autoAlpha: 0 });
        var tl = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 0.6, defaults: { ease: 'power2.out' } });
        tl.set(m, { autoAlpha: 0 }).set(st, { v: 0 }).set($(root, '[data-feed]'), { y: function () { return shift(m[0]); } });
        typeIn(tl, root, m[0].textContent, 1.6);
        pop(tl, m[0]); thinking(tl, root); pop(tl, m[1]);
        tl.from(rows, { autoAlpha: 0, x: -10, duration: 0.35, stagger: 0.18, immediateRender: false }, '<0.15')
          .to(st, { v: total, duration: 1.1, ease: 'power2.out', onUpdate: function () { out.textContent = fmt.format(Math.round(st.v)); } }, '<');
        typeIn(tl, root, m[2].textContent, 0.8);
        pop(tl, m[2]); thinking(tl, root); pop(tl, m[3]);
        tl.from(rows2, { autoAlpha: 0, x: -10, duration: 0.3, stagger: 0.14, immediateRender: false }, '<0.15');
        reset(tl, root);
