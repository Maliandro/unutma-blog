      },
      change: function (root) {
        var m = $$(root, '[data-m]'), oldT = $(root, '[data-old]'), newT = $(root, '[data-new]');
        var q = $(root, '[data-q]'), done = $(root, '[data-done]'), yes = $(root, '[data-yes]');
        gsap.set(m, { autoAlpha: 0 });
        var tl = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 0.6, defaults: { ease: 'power2.out' } });
        tl.set(m, { autoAlpha: 0 }).set($(root, '[data-feed]'), { y: function () { return shift(m[0]); } }).set(oldT, { autoAlpha: 1 }).set(newT, { autoAlpha: 0 }).set(q, { autoAlpha: 1 }).set(done, { autoAlpha: 0 });
        typeIn(tl, root, m[0].textContent, 1.2);
        pop(tl, m[0]); thinking(tl, root); pop(tl, m[1]);
        tl.to(oldT, { autoAlpha: 0, y: -6, duration: 0.3 }, '+=0.5').fromTo(newT, { autoAlpha: 0, y: 6 }, { autoAlpha: 1, y: 0, duration: 0.35, immediateRender: false }, '<0.1');
        typeIn(tl, root, m[2].textContent, 0.7);
        pop(tl, m[2]); thinking(tl, root); pop(tl, m[3]);
        tapAt(tl, root, yes, '+=0.9');
        tl.to(q, { autoAlpha: 0, duration: 0.25 }).fromTo(done, { autoAlpha: 0, y: 6 }, { autoAlpha: 1, y: 0, duration: 0.35, immediateRender: false }, '<');
