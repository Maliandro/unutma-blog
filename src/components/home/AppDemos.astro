          tl.to(it, { backgroundColor: '#dff3e7', duration: 0.2 }, '<')
            .fromTo(times[k], { autoAlpha: 0, x: 8 }, { autoAlpha: 1, x: 0, duration: 0.35, immediateRender: false }, '<')
