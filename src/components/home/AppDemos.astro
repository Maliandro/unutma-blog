---
/**
 * Ana sayfa "Nasil calisir" — uygulamanin icini gosteren hareketli telefonlar (20 Kas 2026, v2).
 *
 * Sahibi: "Asistan boyle mi gozukuyor ki?" -> HTML taklit ekranlar kaldirildi.
 * Her telefon artik GERCEK 3.30 ekranlarindan olusur (magaza-3.30/ham/{tr,en}):
 * mesajlar/kartlar ayni goruntunun dilimleri, sirayla belirir (RealPhone.astro).
 * Yazilan cumleler gercek ekrandaki cumlelerle harfi harfine aynidir.
 */
import RealPhone from './RealPhone.astro';
import { withBase } from '../../utils/site';
import { makeT, type Lang } from '../../i18n/site';
import { DEMO_TX } from './demo-metinleri';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const T = makeT('src/pages/index.astro', lang);
const X = DEMO_TX[lang];
const shot = (n: string) => withBase(`/img/app/v330/${lang}/${n}.webp`);

const demos = [
  {
    title: T('feat1.title'), body: T('feat1.body'), aria: T('d1.aria'),
    layers: ['a1-bday'], final: 'a1-bday',
    steps: [['show', 'a1-bday', 0], ['wait', 0.4], ['type', 'a1-bday', X.bday1, 1.3], ['band', 'a1-bday', 0], ['band', 'a1-bday', 1], ['wait', 0.9],
      ['type', 'a1-bday', X.bday2, 1.2], ['band', 'a1-bday', 2], ['wait', 0.5], ['band', 'a1-bday', 3], ['wait', 3.2], ['out']],
  },
  {
    title: T('feat2.title'), body: T('feat2.body'), aria: T('feat2.alt'),
    layers: ['a3'], final: 'a3',
    steps: [['show', 'a3', 0], ['wait', 0.4], ['type', 'a3', X.a3q1, 1.5], ['band', 'a3', 0], ['wait', 0.5], ['band', 'a3', 1], ['wait', 1.4],
      ['type', 'a3', X.a3q2, 0.8], ['band', 'a3', 2], ['wait', 0.5], ['band', 'a3', 3], ['wait', 3.4], ['out']],
  },
  {
    title: T('feat3.title'), body: T('feat3.body'), aria: T('feat3.alt'),
    layers: ['a4-ask', 'a4'], final: 'a4',
    steps: [['show', 'a4-ask', 0], ['wait', 0.4], ['type', 'a4-ask', X.a4q1, 1.2], ['band', 'a4-ask', 0], ['wait', 0.4], ['band', 'a4-ask', 1], ['wait', 0.9],
      ['type', 'a4-ask', X.a4q2, 0.8], ['band', 'a4-ask', 2], ['wait', 0.4], ['band', 'a4-ask', 3], ['wait', 1.1], ['tap', 'a4-ask'],
      ['xfade', 'a4-ask', 'a4', 4], ['band', 'a4', 4], ['wait', 3.2], ['out']],
  },
  {
    title: T('feat4.title'), body: T('feat4.body'), aria: T('feat4.alt'),
    layers: ['e-actions'], final: 'e-actions',
    steps: [['show', 'e-actions'], ['mask', 'e-actions'], ['wait', 1.2], ['unmask', 'e-actions', 0], ['wait', 1], ['unmask', 'e-actions', 1], ['wait', 3.2], ['out']],
  },
  {
    title: T('feat5.title'), body: T('feat5.body'), aria: T('d5.aria'),
    layers: ['e-reminders'], final: 'e-reminders',
    steps: [['show', 'e-reminders', 0], ['stagger', 'e-reminders'], ['wait', 4], ['out']],
  },
  {
    title: T('feat6.title'), body: T('feat6.body'), aria: T('d6.aria'),
    layers: ['e-economy'], final: 'e-economy',
    steps: [['show', 'e-economy', 0], ['stagger', 'e-economy'], ['wait', 4], ['out']],
  },
];

const records = [
  { img: 'e-todo', label: T('rail.todo') },
  { img: 'e-shopping', label: T('rail.shopping') },
  { img: 'e-calendar', label: T('rail.calendar') },
  { img: 'e-journal', label: T('rail.journal') },
];
---

<section class="how" id="how">
  <div class="wrap">
    <h2 class="h2">{T('how.h2')}</h2>
    <p class="lead">{T('how.lead')}</p>
  </div>

  <div class="wrap how__list">
    {demos.map((d, i) => (
      <article class:list={['feat', i % 2 === 1 && 'feat--flip']}>
        <div class="feat__txt">
          <h3>{d.title}</h3>
          <p>{d.body}</p>
        </div>
        <div class="dev">
          <RealPhone lang={lang} layers={d.layers} final={d.final} steps={d.steps} label={d.aria} />
        </div>
      </article>
    ))}
  </div>

  <!-- Kayitlarim: gercek ekranlar arasinda kaydirma -->
  <div class="wrap recs">
    <div class="recs__txt">
      <h3>{T('rail.h3')}</h3>
      <p>{T('rail.p')}</p>
      <div class="recs__tabs" role="tablist" aria-label={T('rail.tabsAria')}>
        {records.map((r, i) => (
          <button type="button" role="tab" class="recs__tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>{r.label}</button>
        ))}
      </div>
    </div>
    <div class="dev dev--recs" data-recs>
      <div class="scr">
        <div class="recs__track" data-track>
          {records.map((r, i) => (
            <img src={shot(r.img)} alt={T('rail.phoneAria', { label: r.label })} width="600" height="1300" loading="lazy" decoding="async" aria-hidden={i === 0 ? undefined : 'true'} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  window.addEventListener('DOMContentLoaded', function () {
    var gsap = window.gsap, ST = window.ScrollTrigger;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var recs = document.querySelector('[data-recs]');
    var tabs = Array.prototype.slice.call(document.querySelectorAll('[data-tab]'));
    var track = document.querySelector('[data-track]');
    if (!recs || !track) return;
    var cur = 0, auto = null;
    function show(i, instant) {
      cur = (i + tabs.length) % tabs.length;
      tabs.forEach(function (t, k) { t.setAttribute('aria-selected', k === cur ? 'true' : 'false'); });
      Array.prototype.forEach.call(track.children, function (im, k) { if (k === cur) im.removeAttribute('aria-hidden'); else im.setAttribute('aria-hidden', 'true'); });
      if (gsap && !instant && !reduce) gsap.to(track, { xPercent: -100 * cur, duration: 0.7, ease: 'power3.inOut', overwrite: true });
      else track.style.transform = 'translateX(' + (-100 * cur) + '%)';
    }
    tabs.forEach(function (t) {
      t.addEventListener('click', function () { show(+t.getAttribute('data-tab')); if (auto) auto.restart(true); });
    });
    if (!gsap || reduce) return;
    if (ST) gsap.registerPlugin(ST);
    auto = gsap.delayedCall(2.8, function () { show(cur + 1); auto.restart(true); }).pause();
    if (ST) ST.create({ trigger: recs, start: 'top 85%', end: 'bottom 10%', onToggle: function (self) { self.isActive ? auto.restart(true) : auto.pause(); } });
  });
</script>

<style>
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  @media (min-width: 640px) {
    .wrap {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
  .h2 {
    font-size: clamp(1.85rem, 5.2vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.06;
    color: var(--u-ink);
    text-wrap: balance;
  }
  .lead {
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--u-muted);
    max-width: 36rem;
  }
  .how {
    padding: 5rem 0 4.5rem;
    background: var(--u-mint);
    overflow: hidden;
  }
  .how__list {
    margin-top: 3.5rem;
    display: grid;
    gap: 4.75rem;
  }
  .feat {
    display: grid;
    gap: 1.9rem;
    align-items: center;
  }
  .feat__txt h3,
  .recs__txt h3 {
    font-size: clamp(1.5rem, 4.2vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--u-ink);
    text-wrap: balance;
  }
  .feat__txt p,
  .recs__txt p {
    margin-top: 0.85rem;
    font-size: 1.04rem;
    line-height: 1.65;
    color: var(--u-muted);
    max-width: 28rem;
  }

  /* Telefon cercevesi; ekran gercek 1290x2796 oraninda */
  .dev {
    justify-self: center;
    width: min(320px, 82vw);
    padding: 8px;
    border-radius: 42px;
    background: #0d1f17;
    box-shadow:
      0 0 0 1.5px rgba(255, 255, 255, 0.12) inset,
      0 40px 70px -34px rgba(15, 42, 31, 0.55),
      0 14px 30px -18px rgba(15, 42, 31, 0.35);
  }
  .scr {
    position: relative;
    aspect-ratio: 1290 / 2796;
    border-radius: 34px;
    overflow: hidden;
    background: #f8faf8;
  }

  /* Kayitlarim */
  .recs {
    margin-top: 6rem;
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .recs__tabs {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .recs__tab {
    padding: 0.55rem 1rem;
    border-radius: 99px;
    border: 1px solid var(--u-line);
    background: #fff;
    color: var(--u-ink);
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .recs__tab[aria-selected='true'] {
    background: var(--u-green);
    border-color: var(--u-green);
    color: #fff;
  }
  .recs__tab:focus-visible {
    outline: 2px solid var(--u-green);
    outline-offset: 2px;
  }
  .recs__track {
    display: flex;
    height: 100%;
    will-change: transform;
  }
  .recs__track img {
    flex: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  @media (min-width: 900px) {
    .how {
      padding: 7rem 0 6rem;
    }
    .how__list {
      gap: 6.5rem;
    }
    .feat,
    .recs {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .feat__txt,
    .recs__txt {
      padding-left: 2rem;
    }
    .feat--flip .feat__txt {
      order: 2;
      padding-left: 0;
    }
    .dev {
      width: 370px;
    }
    .recs {
      margin-top: 8rem;
    }
  }
</style>
