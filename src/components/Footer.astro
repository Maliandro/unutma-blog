---
import { withBase } from '../utils/site';
import { makeT, pageLang } from '../i18n/site';

const year = new Date().getFullYear();
const lang = pageLang(Astro.url.pathname);
const T = makeT('src/components/Footer.astro', lang);
const tr = lang === 'tr';
const playStoreUrl =
  import.meta.env.PUBLIC_PLAY_STORE_URL ??
  'https://play.google.com/store/apps/details?id=com.mehmet.unutma';
const appStoreUrl =
  import.meta.env.PUBLIC_APP_STORE_URL ??
  'https://apps.apple.com/app/id6758889495';
---

<footer class="u-foot">
  <div class="u-foot__in">
    <div class="u-foot__brand">
      <a href={withBase(tr ? '/tr/' : '/')} class="u-foot__mark">
        <img src={withBase('/unutma-icon.png')} width="40" height="40" alt="" loading="lazy" decoding="async" />
        <span>Unutma</span>
      </a>
      <p>{T('blurb')}</p>
    </div>

    <nav class="u-foot__col" aria-label={T('col.appAria')}>
      <p class="u-foot__h">{T('col.app')}</p>
      <a href={appStoreUrl} target="_blank" rel="noopener noreferrer">App Store</a>
      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer">Google Play</a>
      <a href={withBase(tr ? '/tr/sss/' : '/faq/')}>{T('link.faq')}</a>
      <a href={withBase(tr ? '/support/tr/' : '/support/')}>{T('link.support')}</a>
    </nav>

    <nav class="u-foot__col" aria-label={T('col.siteAria')}>
      <p class="u-foot__h">{T('col.read')}</p>
      <a href={withBase(tr ? '/tr/blog/' : '/blog/')}>{T('link.blog')}</a>
      <a href={withBase(tr ? '/tr/hakkinda/' : '/about/')}>{T('link.about')}</a>
      <a href={withBase(tr ? '/privacy/tr/' : '/privacy')}>{T('link.privacy')}</a>
      <a href={withBase(tr ? '/terms/tr/' : '/terms')}>{T('link.terms')}</a>
    </nav>

    <nav class="u-foot__col" aria-label={T('col.followAria')}>
      <p class="u-foot__h">{T('col.follow')}</p>
      <a href="https://www.instagram.com/life_admin_assistant/" target="_blank" rel="noopener noreferrer me">Instagram</a>
      <a href="https://www.youtube.com/channel/UCrQXJXpD_ixGkfGQgouqVww" target="_blank" rel="noopener noreferrer me">YouTube</a>
      <a href="https://www.facebook.com/1169165316276395" target="_blank" rel="noopener noreferrer me">Facebook</a>
    </nav>
  </div>

  <div class="u-foot__base">
    <p>{T('copyright', { year })}</p>
    <a href="https://meyadestudio.com/#digital" class="u-foot__studio">
      <Fragment set:html={T('madeBy')} />
    </a>
  </div>
</footer>

<style>
  .u-foot {
    margin-top: 5rem;
    background: var(--u-ink);
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.9rem;
  }
  .u-foot__in {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3.5rem 1rem 2.5rem;
    display: grid;
    gap: 2.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .u-foot__brand {
    grid-column: 1 / -1;
    max-width: 22rem;
  }
  .u-foot__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #fff;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.03em;
  }
  .u-foot__mark img {
    border-radius: 22%;
  }
  .u-foot__brand p {
    margin-top: 0.85rem;
    line-height: 1.6;
  }
  .u-foot__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .u-foot__h {
    color: #fff;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .u-foot a:not(.u-foot__mark):hover {
    color: #fff;
  }
  .u-foot__base {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.25rem 1rem 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: space-between;
    font-size: 0.8rem;
  }
  .u-foot__studio strong {
    color: #fff;
    font-weight: 600;
  }
  @media (min-width: 860px) {
    .u-foot__in {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
    .u-foot__brand {
      grid-column: auto;
    }
  }
</style>
