---
import BaseLayout from './BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
import AdSense from '../components/AdSense.astro';
import AppStoreBanner from '../components/AppStoreBanner.astro';
import ShareButtons from '../components/ShareButtons.astro';
import AppSchema from '../components/AppSchema.astro';
import { coverForSlug } from '../utils/covers';
import { withBase } from '../utils/site';
import { pageImage } from '../utils/webp';
import { tagSlug } from '../utils/posts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, image } = post.data;
const heroImage = withBase(pageImage(image ?? coverForSlug(post.slug)));
const heroAlt = post.data.imageAlt ?? `${title} — article cover`;
---

<BaseLayout>
  <Fragment slot="head">
  <SEOHead
    title={post.data.seoTitle ?? title}
    description={description}
    image={image ?? coverForSlug(post.slug)}
    article={true}
    publishedDate={pubDate}
    modifiedDate={post.data.updatedDate}
    keywords={tags}
    imageAlt={heroAlt}
  />
  <AppSchema />
  </Fragment>

  <article class="mx-auto max-w-3xl px-4 pb-8 pt-10 md:pt-14">
    <header class="mb-10">
      <a href="/blog/" class="mb-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-dark">
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5l-5 5 5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        All articles
      </a>
      <img
        src={heroImage}
        alt={heroAlt}
        width={1200}
        height={630}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="mb-9 w-full rounded-3xl object-cover aspect-[1200/630] ring-1 ring-mint-line"
      />
      <h1 class="brand-hero-title mb-4 text-[1.85rem] sm:text-4xl lg:text-[2.6rem]">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
        <time datetime={pubDate.toISOString()}>
          {
            pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        {
          tags?.length ? (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag: string) => (
                <a
                  href={withBase(`/blog/tags/${encodeURIComponent(tagSlug(tag))}/`)}
                  class="rounded-full bg-mint px-2.5 py-1 text-xs font-medium text-brand-dark hover:bg-mint-line"
                >
                  {tag}
                </a>
              ))}
            </div>
          ) : null
        }
      </div>
    </header>

    <AdSense placement="header" />

    <div
      class="prose prose-lg max-w-none prose-img:rounded-2xl"
    >
      <slot />
    </div>

    <AdSense placement="in-article" />

    <AppStoreBanner />

    <ShareButtons
      title={title}
      url={Astro.url.pathname}
      description={description}
    />

    <AdSense placement="footer" />
  </article>
</BaseLayout>
