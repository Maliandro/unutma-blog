---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/site';
import '../styles/global.css';

interface Props {
  /** When no slot head, optional defaults for minimal pages */
  title?: string;
  description?: string;
  /** <html lang>. Blog Ingilizce; cok dilli yasal sayfalar kendi dilini verir. */
  lang?: string;
}

const { title, description, lang = 'en' } = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';
// Google Search Console dogrulamasi. Iki yol da calisir:
//   1) Vercel'de PUBLIC_GSC_VERIFICATION env degiskeni (panel gerektirir), ya da
//   2) asagidaki sabite GSC'nin verdigi kodu yazmak (sadece commit gerektirir).
// Kod gizli bir sey degil — sayfa kaynaginda zaten herkese gorunur.
// Ikisi de bos ise etiket hic basilmaz.
const GSC_CODE = '';
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || GSC_CODE;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}
    <link rel="icon" type="image/png" href={withBase('/unutma-icon.png')} sizes="512x512" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/unutma-icon.png')} />
    {/* Fontlar kendi alanimizdan (src/styles/fonts.css). Govde fontu preload: ilk boyamada hazir,
        olculu fallback yuzleri sayesinde swap'ta kayma yok (CLS < 0,1). */}
    <link rel="preload" href={withBase('/fonts/plus-jakarta-sans-normal-latin.woff2')} as="font" type="font/woff2" crossorigin />
    {title && !Astro.slots.has('head') && (
      <>
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
      </>
    )}
    <slot name="head" />
    {
      adsenseClient && import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true' && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="min-h-screen bg-white font-sans text-gray-800 subpixel-antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
