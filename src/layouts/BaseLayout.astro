---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/site';
import '../styles/global.css';

interface Props {
  /** When no slot head, optional defaults for minimal pages */
  title?: string;
  description?: string;
  /** <html lang>. Blog Ingilizce; cok dilli yasal sayfalar kendi dilini verir. */
  lang?: string;
  /** Ana sayfa: ust bar yesil sahnenin ustunde saydam baslar. */
  heroTone?: 'green';
}

const { title, description, lang = 'en', heroTone } = Astro.props;
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? '';
// Google Search Console dogrulamasi. Iki yol da calisir:
//   1) Vercel'de PUBLIC_GSC_VERIFICATION env degiskeni (panel gerektirir), ya da
//   2) asagidaki sabite GSC'nin verdigi kodu yazmak (sadece commit gerektirir).
// Kod gizli bir sey degil — sayfa kaynaginda zaten herkese gorunur.
// Ikisi de bos ise etiket hic basilmaz.
const GSC_CODE = '';
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || GSC_CODE;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="msvalidate.01" content="43C23066E353D060195EB93B3DF61240" />
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}
    <link rel="icon" type="image/png" href={withBase('/favicon-32.png')} sizes="32x32" />
    <link rel="icon" type="image/png" href={withBase('/favicon-48.png')} sizes="48x48" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    {/* Fontlar kendi alanimizdan (src/styles/fonts.css). Govde + baslik fontu preload: ilk boyamada hazir,
        olculu fallback yuzleri sayesinde swap'ta kayma yok (CLS < 0,1). */}
    <link rel="preload" href={withBase('/fonts/plus-jakarta-sans-normal-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content={heroTone === 'green' ? '#1E9E5E' : '#FFFFFF'} />
    {title && !Astro.slots.has('head') && (
      <>
        <title>{title}</title>
        {description && <meta name="description" content={description} />}
      </>
    )}
    <slot name="head" />
    {
      adsenseClient && import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true' && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="min-h-screen font-sans antialiased">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header tone={heroTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
