---
/**
 * FAQ sayfasi — hem insan hem cevap motorlari icin.
 *
 * NEDEN: ChatGPT/Perplexity/Google AI Overviews gibi cevap motorlari
 * FAQPage semasini yogun kullanir. Buradaki sorular insanlarin bu tur bir
 * uygulamayi ARARKEN sordugu gercek sorular; cevaplar urunde dogrulanmis.
 *
 * KURAL: uygulamanin yapamadigi seyler de acikca yaziliyor. Eksik gizlemek
 * kisa vadede iyi gorunur ama yanlis oneriye ve kotu yoruma yol acar.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
import AppSchema from '../components/AppSchema.astro';
import StoreBadgeRow from '../components/StoreBadgeRow.astro';

const faqs: { q: string; a: string }[] = [
  {
    q: 'Does Unutma work without an internet connection?',
    a: 'Yes. Unutma works fully offline, including in airplane mode. There is no server involved in normal use — every feature, including the vault, reminders and lists, runs on the device.',
  },
  {
    q: 'Do I need to create an account?',
    a: 'No. There is no sign-up and no login anywhere in the app. You open it and start using it. Because there is no account, there is also no password to be leaked and no profile to be sold.',
  },
  {
    q: 'Where is my data stored?',
    a: 'Only on your device, encrypted. Unutma has no cloud sync and no server holding user content. The vault uses AES-256 with the key held in the device keychain or keystore and unlocked with Face ID, Touch ID or the equivalent Android biometric.',
  },
  {
    q: 'Does Unutma sync between my phone and my tablet?',
    a: 'No, and this is the honest trade-off of the offline design. There is no automatic cross-device sync. You can move your data manually using the export and device-transfer feature, but if you need continuous multi-device sync, Unutma is not the right choice.',
  },
  {
    q: 'What does Unutma actually replace?',
    a: 'A reminders app, a to-do list, a journal or diary, a calendar, a notes app, a shopping list, a habit or routine tracker, an expense tracker and a password vault. The point is one habit to maintain instead of nine.',
  },
  {
    q: 'How does the voice command work?',
    a: 'You say a normal sentence such as "dentist tomorrow at 3, remind me" and the app works out which list it belongs to and what time to set. It is rule-based rather than cloud AI, which is why it runs offline, and it works in all eight supported languages.',
  },
  {
    q: 'How much does Unutma cost?',
    a: 'There is a 7-day free trial with no credit card required. After that it is $2.99 per month, $29.99 per year, or $79.99 as a one-time lifetime purchase. There are no ads at any tier.',
  },
  {
    q: 'Which languages does Unutma support?',
    a: 'English, Turkish, German, Spanish, French, Italian, Arabic and Chinese — including the voice command feature.',
  },
  {
    q: 'Is Unutma only for people with ADHD?',
    a: 'No. People with ADHD are one audience because low-friction capture matters to them, but the app is built for anyone trying to keep a system running — people juggling work and home, people who keep abandoning planners, and people who care about privacy.',
  },
  {
    q: 'Can I share a list with someone else?',
    a: 'Not in real time. Unutma is single-user by design because there is no server to coordinate shared state. You can export and send a list, but collaborative or shared lists are not supported.',
  },
  {
    q: 'What happens if I lose my phone?',
    a: 'If you have not made a manual backup, the data is gone — there is no cloud copy to restore from. This is the direct cost of the no-server design. Backup and restore are built in and take a few taps; doing it periodically is strongly recommended.',
  },
  {
    q: 'Does Unutma show ads or track me?',
    a: 'No ads and no third-party tracking of your content. Optional anonymous usage analytics can be switched off in Settings under Data.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout>
  <Fragment slot="head">
    <SEOHead
      title="Unutma FAQ — offline planner, no account, encrypted vault"
      description="Straight answers about Unutma: how it works offline, why there is no account, where data is stored, what it costs, and what it deliberately cannot do."
    />
    <AppSchema />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="mx-auto max-w-3xl px-4 py-14">
    <h1 class="brand-hero-title text-3xl md:text-4xl">Frequently asked questions</h1>
    <p class="mt-4 text-lg leading-relaxed text-gray-600">
      Plain answers about what Unutma is, how the offline model works, and — just
      as importantly — what it deliberately does not do.
    </p>

    <div class="mt-10 divide-y divide-gray-100">
      {faqs.map((f) => (
        <div class="py-6">
          <h2 class="font-display text-xl font-semibold text-gray-900">{f.q}</h2>
          <p class="mt-3 leading-relaxed text-gray-600">{f.a}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 rounded-2xl border border-gray-100 bg-gray-50 p-6">
      <h2 class="font-display text-xl font-semibold text-gray-900">Try it for a week</h2>
      <p class="mt-2 text-gray-600">
        Seven days free, no account and no card required.
      </p>
      <div class="mt-5"><StoreBadgeRow /></div>
    </div>
  </section>
</BaseLayout>
