---
/**
 * Ana sayfa — 3.30 yeniden tasarim (19 Kas 2026).
 *
 * Acilis sahnesi gercek uygulama akisinin kopyasidir (magaza-3.30 ham ekranlari
 * e-home, a2-ask, a2): yesil asistan ekrani -> cumle yazilir -> "3 ayri kayit
 * gordum, hepsini kaydedeyim mi?" -> Takvim / Alisveris / Butce kartlari.
 * Uydurma ozellik YOK. Fiyat yazilmaz (magazada okunur).
 * Ana vaat (sahibi 16 Kas): telefondan cikmaz / ucak modunda calisir / hesap yok.
 * Hareket: GSAP (public/vendor/gsap, yerel). prefers-reduced-motion'da sahne
 * son karede durur, dongu yok.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
import AppSchema from '../components/AppSchema.astro';
import BlogCard from '../components/BlogCard.astro';
import StoreBadgeRow from '../components/StoreBadgeRow.astro';
import { withBase } from '../utils/site';
import { coverForSlug } from '../utils/covers';
import { getLivePosts } from '../utils/posts';
import { pageImage } from '../utils/webp';

const all = await getLivePosts();
const sorted = all.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const PINNED_SLUG = 'unutma-app-showcase-complete-guide';
const pinned = sorted.find((p) => p.slug === PINNED_SLUG) ?? sorted.find((p) => p.data.featured) ?? sorted[0];
const latest = sorted.filter((p) => p.slug !== pinned?.slug).slice(0, 3);
const pinnedCover = pinned ? withBase(pageImage(pinned.data.image ?? coverForSlug(pinned.slug))) : '';

const typed = "Zoe's birthday dinner Saturday at 7pm, buy milk and eggs, spent 64 dollars on groceries";

const features = [
  {
    img: 'ask-later',
    w: 720,
    h: 737,
    title: 'Tell it once. Ask it later.',
    body: 'Mention where you parked, a birthday, a gate code. Ask next week and the answer comes from your own notes, with the note it came from.',
    alt: 'Unutma assistant saving "I parked the car on level B2" as a note, then answering "Where is my car?" with its source.',
  },
  {
    img: 'ask-life',
    w: 720,
    h: 1395,
    title: 'Ask about your own life.',
    body: 'What did I spend on groceries this month? What is on tomorrow? You get a straight answer and the records behind it.',
    alt: 'Unutma answering a grocery spending question with a total and two records, and listing tomorrow\'s plans.',
  },
  {
    img: 'asks-first',
    w: 720,
    h: 636,
    title: 'Change it by saying so.',
    body: 'Move the team meeting to 11. When it is not sure what you meant, it asks before touching anything, and changes can be undone.',
    alt: 'Unutma moving a team meeting to 11:00 and asking "Did you mean this?" before changing an evening walk.',
  },
  {
    img: 'quick-logs',
    w: 720,
    h: 815,
    title: 'Did I lock the door?',
    body: 'Log the small things with one tap: door locked, stove off, medicine taken. When the doubt comes back, the time is right there.',
    alt: 'Unutma Quick Actions list with logged times for locking the door and turning off the stove.',
  },
];

const rail = [
  { img: 'todo', label: 'To-dos' },
  { img: 'shopping', label: 'Shopping list' },
  { img: 'economy', label: 'Budget' },
  { img: 'journal', label: 'Journal and mood' },
  { img: 'calendar', label: 'Calendar' },
  { img: 'reminders', label: 'Routines' },
];

const faqs = [
  {
    q: 'Does it need the internet?',
    a: 'No. The assistant, your lists, reminders, journal and vault run on the phone, including in airplane mode. Typing always works offline. If you speak instead, your phone\'s own speech service turns your voice into text, on the device when your phone supports that language offline.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. There is no sign-up and no login. Open the app and start. With no account there is no password to leak and no profile to sell.',
  },
  {
    q: 'Where are my notes stored?',
    a: 'Only on your phone. There is no cloud copy and no server holding your content. The vault and journal are encrypted on the device. You can make an encrypted backup file and keep it wherever you choose.',
  },
  {
    q: 'Is it a chatbot?',
    a: 'No. It does not chat about the world. It understands sentences about your own day, saves them in the right place, and answers questions about what you saved.',
  },
  {
    q: 'What does it cost?',
    a: 'Every feature is open for your first 7 days, with no card. After that, adding and editing needs a subscription or a one-time purchase. Everything you saved stays visible and your reminders keep ringing. The price for your country is shown in the App Store and Google Play. No ads, ever.',
  },
  {
    q: 'Which languages does it speak?',
    a: 'The app is in English, Turkish, German, Spanish, French, Italian, Arabic and Chinese. The assistant understands the first six.',
  },
];
---

<BaseLayout heroTone="green">
  <Fragment slot="head">
    <SEOHead
      title="Unutma: Life Admin Assistant, Private and Offline"
      description="Say it once and Unutma files it: reminders, lists, calendar and expenses. Runs on your phone, works in airplane mode, no account needed."
    />
    <AppSchema />
    <link rel="preload" href={withBase('/vendor/gsap/gsap.min.js')} as="script" />
  </Fragment>

  <!-- 1. Acilis sahnesi -->
  <section class="hero" data-hero>
    <div class="hero__in">
      <div class="hero__copy">
        <h1 class="hero__h">Say it once. It lands in the right place.</h1>
        <p class="hero__sub">
          Unutma is a life admin assistant that lives on your phone. Type or say a sentence and it
          becomes a reminder, a list item or an expense. Later, ask what is coming up or what you spent.
        </p>
        <StoreBadgeRow tone="green" class="hero__stores" />
        <ul class="hero__vow" aria-label="What Unutma promises">
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M11 18.5h2" /></svg>
            Runs on your phone
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15.5v-2l-8-5V3.8a1.5 1.5 0 0 0-3 0v4.7l-8 5v2l8-2.5v5l-2 1.5V21l3.5-1 3.5 1v-1.5l-2-1.5v-5z" /></svg>
            Works in airplane mode
          </li>
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4.5 20.5c1.4-3.6 4.2-5.5 7.5-5.5s6.1 1.9 7.5 5.5M3 3l18 18" /></svg>
            No account
          </li>
        </ul>
      </div>

      <div class="hero__stage">
        <div class="phone" role="img" aria-label="Unutma turning one sentence into a calendar entry, a shopping item and a budget line.">
          <div class="phone__screen" aria-hidden="true">
            <!-- Sohbet ekrani (son kare; JS yoksa ve azaltilmis harekette bu gorunur) -->
            <div class="sc sc-chat" data-chat>
              <div class="ch-top">
                <span class="ch-back"></span>
                <img src={withBase('/unutma-icon.png')} alt="" width="40" height="40" />
                <div>
                  <b>Assistant</b>
                  <small><i></i>Offline, runs on your phone</small>
                </div>
              </div>
              <div class="ch-body">
                <p class="m-user" data-user>{typed}</p>
                <div class="m-bot" data-bot>
                  <p>I see 3 separate entries in this. Save them all?</p>
                  <ul>
                    <li>Calendar: Zoe's birthday dinner</li>
                    <li>Shopping: buy milk and eggs</li>
                    <li>Budget: groceries, $64</li>
                  </ul>
                  <div class="m-bot__btns" data-btns>
                    <span class="b-save" data-save>Save all</span>
                    <span class="b-one">Keep as one entry</span>
                  </div>
                </div>
                <div class="m-card" data-card>
                  <span class="m-card__k"><svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M9 3v4M15 3v4" /></svg>Calendar</span>
                  <b>Zoe's birthday dinner</b>
                  <span class="m-card__chip">Saturday 7:00 PM</span>
                  <i class="m-ok" data-ok></i>
                </div>
                <div class="m-card" data-card>
                  <span class="m-card__k"><svg viewBox="0 0 24 24"><path d="M3 4h2.5l2.2 11h10.6L20.5 7H7" /><circle cx="9" cy="19" r="1.4" /><circle cx="17" cy="19" r="1.4" /></svg>Shopping</span>
                  <b>buy milk and eggs</b>
                  <i class="m-ok" data-ok></i>
                </div>
                <div class="m-card" data-card>
                  <span class="m-card__k"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2.5" /><path d="M16 12.5h2M3 10h18" /></svg>Budget</span>
                  <b>groceries · $64</b>
                  <span class="m-card__chip">Groceries</span>
                  <i class="m-ok" data-ok></i>
                </div>
              </div>
              <div class="ch-input"><span class="mic"></span>Write or speak: a task, note, expense...<span class="send"></span></div>
            </div>

            <!-- Yesil asistan ekrani (3.30 tam ekran asistan) -->
            <div class="sc sc-green" data-green>
              <div class="g-pill">Today · 3 reminders · 1 birthday</div>
              <div class="g-orb" data-orb>
                <span class="g-ring" data-ring></span>
                <span class="g-ring" data-ring></span>
                <img src={withBase('/unutma-icon.png')} alt="" width="120" height="120" />
              </div>
              <p class="g-say">Say something or ask</p>
              <div class="g-input" data-ginput>
                <span class="g-text"><span data-typed></span><span class="g-caret" data-caret></span><span class="g-ph" data-ph>or type</span></span>
                <span class="g-send" data-send></span>
              </div>
              <div class="g-chips">
                <span>When is Dentist?</span><span>What's on tomorrow?</span><span>Did I lock the door?</span>
              </div>
              <div class="g-rec">My records</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Vaat -->
  <section class="vow" id="private">
    <div class="wrap vow__grid">
      <div class="vow__lead">
        <h2 class="h2">Your life stays on your phone.</h2>
        <p class="lead">
          Unutma was built without a server for your notes. Nothing to sign up for, nothing to sync, nothing on our side to
          leak.
        </p>
        <div class="air" aria-hidden="true">
          <div class="air__row">
            <span class="air__ic"><svg viewBox="0 0 24 24"><path d="M21 15.5v-2l-8-5V3.8a1.5 1.5 0 0 0-3 0v4.7l-8 5v2l8-2.5v5l-2 1.5V21l3.5-1 3.5 1v-1.5l-2-1.5v-5z" /></svg></span>
            Airplane Mode
            <span class="air__sw"></span>
          </div>
          <div class="air__msg">
            <span class="air__you">Tomorrow 2pm call mom</span>
            <span class="air__ok"><i></i>Reminder · Tomorrow 2:00 PM</span>
          </div>
        </div>
      </div>
      <ul class="vow__list">
        <li>
          <h3>Works in airplane mode</h3>
          <p>The assistant runs on the phone itself. Your lists, reminders and answers work with no connection at all.</p>
        </li>
        <li>
          <h3>No account</h3>
          <p>No sign-up, no login, no email address. You open the app and start.</p>
        </li>
        <li>
          <h3>No cloud copy, no ads</h3>
          <p>Your vault and journal are encrypted on the device. Backups are files you make and keep where you choose.</p>
        </li>
      </ul>
    </div>
    <p class="wrap vow__note">
      Speaking instead of typing? Your phone's own speech service turns your voice into text, on the device when your
      phone supports that language offline. Typing never needs a connection.
      <a href={withBase('/privacy')}>Read the privacy policy</a>
    </p>
  </section>

  <!-- 3. Ozellikler -->
  <section class="how" id="how">
    <div class="wrap">
      <h2 class="h2 how__h">One sentence is enough.</h2>
      <p class="lead how__lead">
        No forms, no menus to learn. Write it the way you would say it. Unutma shows you what it understood before it saves.
      </p>
    </div>
    <div class="wrap how__list">
      {features.map((f, i) => (
        <article class:list={['feat', i % 2 === 1 && 'feat--flip']}>
          <div class="feat__txt">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
          <figure class="feat__shot">
            <img
              src={withBase(`/img/app/${f.img}.webp`)}
              alt={f.alt}
              width={f.w}
              height={f.h}
              loading="lazy"
              decoding="async"
              data-par
            />
          </figure>
        </article>
      ))}
    </div>

    <div class="wrap rail-h">
      <h3>Everything else, under My records</h3>
      <p>Plus an encrypted vault, home screen widgets and 12 themes.</p>
    </div>
    <div class="rail" role="list">
      {rail.map((r) => (
        <figure class="rail__it" role="listitem">
          <img src={withBase(`/img/app/${r.img}.webp`)} alt={`Unutma ${r.label} screen`} width="480" height="1040" loading="lazy" decoding="async" />
          <figcaption>{r.label}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- 4. SSS -->
  <section class="faq" id="faq">
    <div class="wrap faq__grid">
      <div>
        <h2 class="h2">Questions people ask first</h2>
        <p class="lead">More answers, including what Unutma deliberately does not do, are on the <a href={withBase('/faq/')}>FAQ page</a>.</p>
      </div>
      <div class="faq__list">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<span class="faq__pm" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Blog -->
  {pinned && (
    <section class="blog" id="blog">
      <div class="wrap">
        <div class="blog__head">
          <h2 class="h2">From the blog</h2>
          <a href={withBase('/blog/')} class="blog__all">All articles</a>
        </div>
        <a href={withBase(`/blog/${pinned.slug}/`)} class="pin">
          <img src={pinnedCover} alt="" width="1200" height="630" loading="lazy" decoding="async" />
          <div class="pin__txt">
            <span class="pin__tag">The full app guide</span>
            <h3>{pinned.data.title}</h3>
            <p>{pinned.data.description}</p>
          </div>
        </a>
        <div class="blog__grid">
          {latest.map((post) => <BlogCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <!-- 6. Indir -->
  <section class="get" id="get">
    <div class="wrap">
      <div class="get__box">
        <img src={withBase('/unutma-icon.png')} width="88" height="88" alt="" loading="lazy" decoding="async" />
        <h2>Try every feature free for 7 days.</h2>
        <p>No card and no account. After the trial, everything you saved stays visible and your reminders keep ringing.</p>
        <StoreBadgeRow tone="green" class="get__stores" />
        <small>iPhone, iPad and Android. Prices for your country are shown in the store.</small>
      </div>
    </div>
  </section>

  <script is:inline src={withBase('/vendor/gsap/gsap.min.js')} defer></script>
  <script is:inline src={withBase('/vendor/gsap/ScrollTrigger.min.js')} defer></script>
  <script is:inline define:vars={{ typed }}>
    window.addEventListener('DOMContentLoaded', function () {
      var gsap = window.gsap;
      if (!gsap) return;
      var ST = window.ScrollTrigger;
      if (ST) gsap.registerPlugin(ST);
      var q = function (s) { return document.querySelector(s); };
      var qa = function (s) { return Array.prototype.slice.call(document.querySelectorAll(s)); };
      var green = q('[data-green]'), chat = q('[data-chat]'), out = q('[data-typed]'), ph = q('[data-ph]'),
        caret = q('[data-caret]'), send = q('[data-send]'), user = q('[data-user]'), bot = q('[data-bot]'),
        btns = q('[data-btns]'), save = q('[data-save]'), cards = qa('[data-card]'), oks = qa('[data-ok]'),
        rings = qa('[data-ring]'), orb = q('[data-orb]');
      if (!green || !chat) return;

      var mm = gsap.matchMedia();
      mm.add(
        { motion: '(prefers-reduced-motion: no-preference)', calm: '(prefers-reduced-motion: reduce)' },
        function (ctx) {
          if (ctx.conditions.calm) {
            // Sakin: son kare (sohbet + 3 kart) durur, yesil ekran gizli.
            gsap.set(green, { autoAlpha: 0 });
            return;
          }

          // --- Acilis sahnesi: tek, ozenli dongu ---
          document.documentElement.classList.add('js-hero');
          var state = { n: 0 };
          var render = function () {
            var k = Math.round(state.n);
            out.textContent = typed.slice(0, k);
            ph.style.display = k ? 'none' : '';
          };
          gsap.set(chat, { autoAlpha: 0 });
          gsap.set([user, bot], { autoAlpha: 0, y: 14 });
          gsap.set(cards, { autoAlpha: 0, y: 16 });
          gsap.set(oks, { scale: 0 });
          gsap.set(btns, { autoAlpha: 1 });

          var ringTl = gsap.timeline({ repeat: -1 });
          ringTl.fromTo(rings, { scale: 1, autoAlpha: 0.5 }, { scale: 1.55, autoAlpha: 0, duration: 2.4, ease: 'sine.out', stagger: 1.2 });

          var caretTw = gsap.to(caret, { autoAlpha: 0, duration: 0.45, repeat: -1, yoyo: true, ease: 'steps(1)' });

          var tl = gsap.timeline({ repeat: -1, repeatDelay: 0.4, defaults: { ease: 'power2.out' } });
          tl.set(state, { n: 0, onComplete: render })
            .set(green, { autoAlpha: 1, scale: 1 })
            .set(chat, { autoAlpha: 0 })
            .set([user, bot], { autoAlpha: 0, y: 14 })
            .set(cards, { autoAlpha: 0, y: 16 })
            .set(oks, { scale: 0 })
            .set(btns, { autoAlpha: 1, height: 'auto' })
            .set(save, { scale: 1 })
            .fromTo(orb, { scale: 0.92 }, { scale: 1, duration: 0.9, ease: 'power3.out' })
            .to(state, { n: typed.length, duration: 3.4, ease: 'none', onUpdate: render }, '+=0.3')
            .to(send, { scale: 0.8, duration: 0.12, yoyo: true, repeat: 1 }, '+=0.35')
            .to(green, { autoAlpha: 0, scale: 1.04, duration: 0.5, ease: 'power2.in' })
            .to(chat, { autoAlpha: 1, duration: 0.35 }, '<0.2')
            .to(user, { autoAlpha: 1, y: 0, duration: 0.5 })
            .to(bot, { autoAlpha: 1, y: 0, duration: 0.5 }, '+=0.45')
            .to(save, { scale: 0.92, duration: 0.14, yoyo: true, repeat: 1 }, '+=1.1')
            .to(btns, { autoAlpha: 0, height: 0, duration: 0.35, ease: 'power2.inOut' }, '+=0.1')
            .to(cards, { autoAlpha: 1, y: 0, duration: 0.5, stagger: 0.32 }, '<0.1')
            .to(oks, { scale: 1, duration: 0.4, ease: 'back.out(2.4)', stagger: 0.32 }, '<0.25')
            .to(chat, { autoAlpha: 0, duration: 0.5, ease: 'power1.in' }, '+=3.2');

          // Ekrandan cikinca dur, donunce devam (pil ve islemci).
          if (ST) {
            ST.create({
              trigger: '[data-hero]',
              start: 'top bottom',
              end: 'bottom top',
              onToggle: function (self) {
                [tl, ringTl, caretTw].forEach(function (a) { self.isActive ? a.play() : a.pause(); });
              },
            });

            // Ozellik ekranlarinda cok hafif derinlik (yalniz genis ekran).
            var wide = window.matchMedia('(min-width: 900px)').matches;
            if (wide) {
              qa('[data-par]').forEach(function (img) {
                gsap.fromTo(img, { y: 28 }, {
                  y: -28, ease: 'none',
                  scrollTrigger: { trigger: img.parentNode, start: 'top bottom', end: 'bottom top', scrub: 0.6 },
                });
              });
            }
          }
          return function () { document.documentElement.classList.remove('js-hero'); gsap.set([green, chat, user, bot, cards, oks, btns], { clearProps: 'all' }); };
        }
      );
    });
  </script>
</BaseLayout>

<style>
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding-left: 1rem;
    padding-right: 1rem;
  }
  @media (min-width: 640px) {
    .wrap {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
  }
  .h2 {
    font-size: clamp(1.85rem, 5.2vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.06;
    color: var(--u-ink);
    text-wrap: balance;
  }
  .lead {
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--u-muted);
    max-width: 36rem;
  }
  .lead a,
  .vow__note a {
    color: var(--u-green);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(8, 127, 91, 0.35);
  }

  /* ---------- 1. Hero ---------- */
  .hero {
    position: relative;
    color: #fff;
    background:
      radial-gradient(60% 50% at 78% 38%, rgba(255, 255, 255, 0.16), transparent 70%),
      linear-gradient(180deg, #3acb7e 0%, #22a964 45%, #0f7d47 100%);
    overflow: hidden;
  }
  .hero__in {
    max-width: 72rem;
    margin: 0 auto;
    padding: 6.25rem 1rem 0;
    display: grid;
    gap: 2.75rem;
  }
  .hero__h {
    font-size: clamp(2.3rem, 8.6vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -0.038em;
    word-spacing: 0.06em;
    line-height: 1.02;
    text-wrap: balance;
    max-width: 11.5em;
  }
  .hero__sub {
    margin-top: 1.25rem;
    font-size: 1.06rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    max-width: 31rem;
  }
  .hero__copy :global(.hero__stores) {
    margin-top: 1.75rem;
  }
  .hero__vow {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
  }
  @media (max-width: 639px) {
    .hero__vow {
      flex-direction: column;
    }
  }
  .hero__vow li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .hero__vow svg,
  .air__ic svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hero__stage {
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  /* Telefon: gercek ekranin olculeri (1290x2796), icerik cqw ile olceklenir */
  .phone {
    width: min(300px, 80vw);
    aspect-ratio: 1290 / 2796;
    padding: 9px;
